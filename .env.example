APP_NAME="Bantay Cordova"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bantay_cordova
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GEMINI_API_KEY=         # free key from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_TOKEN_BUDGET=20000
AI_RETRY_ATTEMPTS=1      # retries after the first request, for transient failures only
AI_RETRY_DELAY_MS=350
AI_CIRCUIT_BREAKER=true
AI_CIRCUIT_THRESHOLD=3
AI_CIRCUIT_TTL_SECONDS=60
AI_RESPONSE_MAX_CHARS=4000
AI_OFFLINE_HELP=true   # grounded local answers when Gemini is unavailable
AI_SCOPE_GUARD=true    # reject non-Bantay-Cordova questions before answer generation
AI_SCOPE_LOCAL_CHECK=true  # fast path for clearly documented system topics
AI_SCOPE_CLASSIFIER_MODEL= # blank uses GEMINI_MODEL
AI_SCOPE_MAX_TOKENS=64

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
